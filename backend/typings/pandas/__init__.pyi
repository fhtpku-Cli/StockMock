# 仅声明 A 股日历补充所需的最小 pandas 接口；运行仍调用实际依赖。
from collections.abc import Iterator, Sequence
from datetime import datetime

class Timestamp:
    year: int
    def __init__(self, value: datetime | str) -> None: ...
    def to_pydatetime(self) -> datetime: ...

class DatetimeIndex:
    def __init__(self, data: Sequence[str] | DatetimeIndex) -> None: ...
    def append(self, other: DatetimeIndex) -> DatetimeIndex: ...
    def sort_values(self) -> DatetimeIndex: ...
    def equals(self, other: DatetimeIndex) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Timestamp]: ...
