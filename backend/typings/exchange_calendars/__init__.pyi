# 仅声明本应用使用的上游日历接口；运行仍调用实际依赖。
from datetime import datetime, tzinfo
from typing import Literal, Protocol

class Timestamp(Protocol):
    def to_pydatetime(self) -> datetime: ...

class ExchangeCalendar(Protocol):
    tz: tzinfo
    last_session: Timestamp
    def date_to_session(self, date: str, direction: Literal["next", "previous", "none"]) -> Timestamp: ...
    def session_open(self, session: Timestamp) -> Timestamp: ...
    def session_close(self, session: Timestamp) -> Timestamp: ...
    def next_session(self, session: Timestamp) -> Timestamp: ...
    def previous_session(self, session: Timestamp) -> Timestamp: ...
    def is_open_on_minute(self, minute: datetime, ignore_breaks: bool = False) -> bool: ...

def get_calendar(name: str) -> ExchangeCalendar: ...
